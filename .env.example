# Copy to .env.local (never commit it). NOTHING here may carry a NEXT_PUBLIC_ prefix (PRD R-2).

# --- Supabase (local: values printed by `pnpm db:start`; hosted: Project Settings > API) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Identity adapter (BR-26) ---
# fixture = Supabase Auth demo users (dev, tests, demo-day fallback)
# campus  = verify Team 01 Identity access tokens
IDENTITY_MODE=fixture
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=wellbeing

# Origin allowed on cookie-authenticated writes. Empty = the request's own origin.
APP_ORIGIN=

# --- Outbound webhook to the Notification Hub, Team 20 (NFR-17) ---
# Until Team 20's endpoint exists, point this at the built-in contract mock.
HUB_WEBHOOK_URL=http://localhost:3000/api/v1/mock/hub
# Generate each secret below with:  openssl rand -hex 24   (the app refuses to start on empty values)
HUB_SIGNING_SECRET=
HUB_MACHINE_TOKEN=
# Secret the Hub signs its delivery receipts with (inbound webhook receiver)
HUB_INBOUND_SECRET=
# Local development only. Set to false in any deployed environment once Team 20's endpoint is used.
# While true, PUT /api/v1/mock/hub (the outage switch) still requires the DISPATCH_TOKEN bearer.
MOCK_HUB_ENABLED=true

# Machine credential for POST /api/v1/internal/events/dispatch (also a GitHub Actions secret)
DISPATCH_TOKEN=
REMINDER_LEAD_HOURS=24
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_SECONDS=30

# --- FR-23 service-finder helper: AI plus deterministic fallback ---
# With AI_FINDER_ENABLED=false (or no key) the keyword fallback answers every time.
AI_FINDER_ENABLED=false
# LLM_PROVIDER: "anthropic" (Claude, default) or "openai-compatible" (Groq's free tier: 0 THB, no card — C-04).
# LLM_MODEL and LLM_BASE_URL default per provider:
#   anthropic          -> claude-opus-5          at https://api.anthropic.com
#   openai-compatible  -> llama-3.1-8b-instant   at https://api.groq.com/openai/v1
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
AI_DAILY_BUDGET=200
AI_TIMEOUT_MS=3000

# FR-22 AI urgency suggestion: ships nothing at MVP. Documented so nobody adds it silently.
AI_URGENCY_SUGGESTION_ENABLED=false

# NFR-04: no analytics, no telemetry
NEXT_TELEMETRY_DISABLED=1

# Seed script
SEED_PASSWORD=demo-password-16
